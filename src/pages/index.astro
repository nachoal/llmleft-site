---
import Layout from "../layouts/Layout.astro";
import AccountsPanel from "../components/AccountsPanel.astro";
import MenuBarStrip from "../components/MenuBarStrip.astro";
import PhonePreview from "../components/PhonePreview.astro";
import UsagePanel from "../components/UsagePanel.astro";
import WidgetMedium from "../components/WidgetMedium.astro";
import { download, faqs, product, release, site } from "../config";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  url: site.url,
  description: site.description,
  applicationCategory: product.applicationCategory,
  operatingSystem: product.operatingSystem,
  softwareVersion: release.version,
  datePublished: release.published,
  downloadUrl: release.downloadUrl,
  image: `${site.url}${site.ogImage}`,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
  },
  featureList: [
    "Claude usage tracking",
    "Codex usage tracking",
    "Grok usage tracking",
    "OpenRouter credit and spend",
    "Multiple Codex and Claude accounts",
    "Reset times and remaining limits",
    "Low-usage and reset notifications",
    "Mac menu bar status",
    "Private CloudKit snapshot for iPhone and widgets",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout schema={[softwareSchema, faqSchema]}>
  <main>
    <section class="hero page-container">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-badge"><span></span> Claude + Codex usage tracker</p>
          <h1>Claude and Codex limits, in your menu bar.</h1>
          <p class="hero-lede">
            LLM Left is a free Mac app that shows how much usage you have left, when each
            limit resets, and whether your pace will last the window. It watches Codex, Claude,
            Grok, and OpenRouter, keeps several accounts side by side, and warns you before a
            window runs out. An iPhone app and widgets stay in sync — your credentials never
            leave your Mac.
          </p>
          <div class="hero-actions">
            <a class="button button-green" href={download.primaryHref}>
              <span>{download.primaryLabel}</span><span aria-hidden="true">↓</span>
            </a>
            <a class="button button-light" href={download.secondaryHref}>{download.secondaryLabel}</a>
          </div>
          <div class="hero-proof" aria-label="System requirements and privacy">
            <span><i>✓</i> Free</span>
            <span><i>✓</i> {product.minimumMacOS}</span>
            <span><i>✓</i> {product.architecture}</span>
            <span><i>✓</i> No account</span>
          </div>
        </div>
        <div class="hero-visual" aria-label="LLM Left open from the Mac menu bar, showing Codex and Claude limits">
          <div class="hero-screen">
            <div class="stage-grid" aria-hidden="true"></div>
            <div class="stage-glow" aria-hidden="true"></div>
            <MenuBarStrip />
            <div class="hero-screen-panel"><UsagePanel /></div>
          </div>
        </div>
      </div>
    </section>

    <section class="signal-strip" aria-label="LLM Left product principles">
      <div class="page-container signal-grid">
        <span>Codex, Claude, Grok &amp; OpenRouter</span>
        <span>Private CloudKit snapshot</span>
        <span>Zero analytics</span>
      </div>
    </section>

    <section id="how-it-works" class="dark-section">
      <div class="page-container">
        <p class="eyebrow eyebrow-green">One live snapshot</p>
        <div class="section-heading dark-heading">
          <h2>One glance. Your providers. Three screens.</h2>
          <p>The same snapshot on every screen: how much is left, when it resets, and whether your pace will last.</p>
        </div>
        <div class="surface-grid">
          <article class="surface-card">
            <div class="surface-visual surface-visual-menu" aria-hidden="true">
              <MenuBarStrip />
              <div class="surface-panel-wrap"><UsagePanel /></div>
            </div>
            <div class="surface-body">
              <span class="card-number">01</span>
              <h3>Mac menu bar</h3>
              <p>See the next limit before you start a long session. Open the panel for reset times, pace, banked resets, and every account you have signed in.</p>
            </div>
          </article>
          <article class="surface-card">
            <div class="surface-visual surface-visual-phone" aria-hidden="true">
              <div class="surface-phone-wrap"><PhonePreview /></div>
            </div>
            <div class="surface-body">
              <span class="card-number">02</span>
              <h3>iPhone companion</h3>
              <p>Carry the same usage snapshot with you through your private iCloud account. Credentials never follow it.</p>
            </div>
          </article>
          <article class="surface-card">
            <div class="surface-visual surface-visual-widgets" aria-hidden="true">
              <div class="surface-widgets-wrap">
                <WidgetMedium />
                <div class="w-lock">
                  <div class="w-lock-text">
                    <strong>Claude · All Models</strong>
                    <span>in 1 day, 12 hr</span>
                  </div>
                  <b>82%</b>
                </div>
              </div>
            </div>
            <div class="surface-body">
              <span class="card-number">03</span>
              <h3>Home &amp; Lock widgets</h3>
              <p>Put remaining usage where you already look, with a timestamp that makes stale data clear.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="accounts" class="accounts-section page-container">
      <p class="eyebrow">Several logins</p>
      <div class="accounts-grid">
        <div class="accounts-copy">
          <h2>Every account. One menu.</h2>
          <p>Sign in to more than one Codex or Claude plan and keep them side by side. Each account has its own quota, history, and alerts, and the menu shows each one's tightest window on a single row.</p>
          <ul class="accounts-points">
            <li><strong>One row per login.</strong> Alias, plan, and the tightest window, with the CLI's own login badged as the default so nothing shows twice.</li>
            <li><strong>Choose who works next.</strong> Pin the account new sessions use, or let Automatic take the one with the most room while keeping a reserve.</li>
            <li><strong>Open a session in Terminal.</strong> Pick a project folder and the CLI opens signed in as that account. When it exits, choose another account and press Enter to continue in the same folder.</li>
            <li><strong>Start a usage window early.</strong> Optional, per account: a tiny fixed request starts the five-hour clock before you sit down, so the reset lands earlier in your day.</li>
          </ul>
        </div>
        <div class="accounts-stage" aria-label="LLM Left accounts menu with two Codex logins, two Claude logins, the Grok login, and OpenRouter credit">
          <div class="stage-grid" aria-hidden="true"></div>
          <div class="stage-glow" aria-hidden="true"></div>
          <AccountsPanel />
        </div>
      </div>
    </section>

    <section class="features-section page-container">
      <p class="eyebrow">Also watching</p>
      <div class="section-heading">
        <h2>The details that decide your day.</h2>
        <p>Alerts, pace, banked resets, and a menu bar that says exactly as much as you want it to.</p>
      </div>
      <div class="feature-grid">
        <article class="feature-card">
          <span class="card-number">01</span>
          <h3>Alerts that wait for proof</h3>
          <p>A warning at 10% remaining and again when a window is used up. The "ready" alert fires only after a fresh check confirms quota is back above the reserve.</p>
        </article>
        <article class="feature-card">
          <span class="card-number">02</span>
          <h3>Pace and forecasts</h3>
          <p>Recent daily use against the daily target, with a projected figure at reset, built from history that never leaves your Mac.</p>
        </article>
        <article class="feature-card">
          <span class="card-number">03</span>
          <h3>Banked Codex resets</h3>
          <p>How many resets you have banked, when the next one expires, and the details behind each one.</p>
        </article>
        <article class="feature-card">
          <span class="card-number">04</span>
          <h3>Grok and OpenRouter</h3>
          <p>Grok's weekly window from the local Grok CLI, and OpenRouter prepaid credit with today's and this week's spend.</p>
        </article>
        <article class="feature-card">
          <span class="card-number">05</span>
          <h3>A menu bar that fits</h3>
          <p>Icon only, the tightest window across the accounts in use, one number per provider, or one number per account.</p>
        </article>
        <article class="feature-card">
          <span class="card-number">06</span>
          <h3>Two Macs, one snapshot</h3>
          <p>Choose which Mac publishes to iCloud. The other keeps its own menu bar without overwriting what your iPhone shows.</p>
        </article>
      </div>
    </section>

    <section class="workflow-section page-container">
      <p class="eyebrow">How it works</p>
      <div class="section-heading">
        <h2>Your Mac reads the usage. iCloud carries a snapshot.</h2>
        <p>The Mac reads supported provider usage locally, shapes only the status fields you need, and makes them available to your Apple devices.</p>
      </div>
      <ol class="workflow-list">
        <li>
          <span>01</span>
          <div><h3>Read locally</h3><p>LLM Left reads Codex, Claude, and Grok usage on your Mac through its signed local helper. OpenRouter credit comes from a management key that stays in your Keychain.</p></div>
        </li>
        <li>
          <span>02</span>
          <div><h3>Reduce to a snapshot</h3><p>Provider labels, remaining percentages, reset dates, forecasts, and account names become a small status record.</p></div>
        </li>
        <li>
          <span>03</span>
          <div><h3>Show it everywhere</h3><p>Your private CloudKit database makes that snapshot available to the iPhone app and widgets.</p></div>
        </li>
      </ol>
    </section>

    <section class="privacy-section">
      <div class="page-container privacy-grid">
        <div class="privacy-copy">
          <p class="eyebrow">Privacy by architecture</p>
          <h2>Your usage crosses devices. Your credentials do not.</h2>
          <p>LLM Left does not sync prompts, conversations, provider credentials, login files, bridge tokens, or detailed history. Account names travel with the snapshot; their logins stay behind. The website does not load analytics or tracking pixels.</p>
          <a class="text-link" href="/privacy/">Read the exact data boundary <span aria-hidden="true">→</span></a>
        </div>
        <div class="privacy-diagram" aria-label="Data that stays on the Mac and data that syncs through private CloudKit">
          <div class="privacy-node privacy-node-mac">
            <span class="node-label">Stays on your Mac</span>
            <ul class="node-list">
              <li>Credentials</li>
              <li>Prompts</li>
              <li>Detailed history</li>
            </ul>
            <span class="node-foot">Read locally by the signed helper</span>
          </div>
          <div class="privacy-flow"><span>Encrypted <i aria-hidden="true">→</i></span></div>
          <div class="privacy-node privacy-node-cloud">
            <span class="node-label">Private CloudKit</span>
            <ul class="node-list">
              <li>Limits</li>
              <li>Reset times</li>
              <li>Snapshot age</li>
            </ul>
            <span class="node-foot">Readable only by your iCloud account</span>
          </div>
        </div>
      </div>
    </section>

    <section class="faq-section page-container">
      <p class="eyebrow">Questions, answered</p>
      <div class="faq-layout">
        <h2>Before you install.</h2>
        <div class="faq-list">
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary><span>{faq.question}</span><i aria-hidden="true">+</i></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="closing-wrap page-container">
      <div class="closing-card">
        <p>LLM LEFT FOR MAC</p>
        <h2>Never hit a limit<br />by surprise.</h2>
        <div class="closing-actions">
          <a class="button button-black" href={release.downloadUrl}>Download version {release.version} <span aria-hidden="true">↓</span></a>
          <a href="/download/">Release details →</a>
        </div>
        <span class="closing-meta">{product.minimumMacOS} · {product.architecture} · {release.size}</span>
      </div>
    </section>
  </main>
</Layout>
