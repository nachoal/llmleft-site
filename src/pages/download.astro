---
import Layout from "../layouts/Layout.astro";
import PageShell from "../components/PageShell.astro";
import { formatReleaseDate, product, release, site } from "../config";

const title = "Download LLM Left for Mac";
const description = `Download LLM Left ${release.version}, the signed Claude and Codex usage tracker for Apple silicon Macs running macOS 14 or later.`;
const published = formatReleaseDate(release.published);
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  url: `${site.url}/download/`,
  description,
  applicationCategory: product.applicationCategory,
  operatingSystem: product.operatingSystem,
  softwareVersion: release.version,
  datePublished: release.published,
  downloadUrl: release.downloadUrl,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Layout title={title} description={description} path="/download/" schema={schema}>
  <PageShell eyebrow="Mac download" title="Download LLM Left." intro="The signed and notarized Mac app is ready. Install it once, then let the menu bar keep the limits visible.">
    <div class="download-card">
      <div class="download-icon"><img src="/icon-192.png" width="104" height="104" alt="LLM Left app icon" /></div>
      <div class="download-main">
        <p class="release-label">CURRENT RELEASE</p>
        <h2>LLM Left {release.version}</h2>
        <p>{product.minimumMacOS} · {product.architecture} · {release.size}</p>
        <div class="download-actions">
          <a class="button button-green" href={release.downloadUrl}>Download DMG <span aria-hidden="true">↓</span></a>
          <a class="text-link" href={release.archiveUrl}>Download ZIP</a>
        </div>
      </div>
    </div>

    <div class="content-grid">
      <article>
        <h2>Install in three steps</h2>
        <ol class="number-list">
          <li><span>1</span><p>Open <strong>{release.filename}</strong>.</p></li>
          <li><span>2</span><p>Drag LLM Left to the Applications folder.</p></li>
          <li><span>3</span><p>Open the app and complete the provider and CloudKit checks.</p></li>
        </ol>
      </article>
      <aside class="info-panel">
        <h2>Release integrity</h2>
        <dl>
          <div><dt>Version</dt><dd>{release.version} ({release.build})</dd></div>
          <div><dt>Published</dt><dd>{published}</dd></div>
          <div><dt>SHA-256</dt><dd><code>{release.sha256}</code></dd></div>
        </dl>
      </aside>
    </div>

    <div class="notice-block">
      <div>
        <p class="eyebrow">iPhone companion</p>
        <h2>The iPhone app is not a public download yet.</h2>
      </div>
      <p>LLM Left includes an iPhone companion and widgets, but there is no public TestFlight or App Store link today. This page will link it only after a public build is available.</p>
    </div>
  </PageShell>
</Layout>
