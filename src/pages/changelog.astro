---
import Layout from "../layouts/Layout.astro";
import PageShell from "../components/PageShell.astro";
import { formatReleaseDate, release, releases, site } from "../config";

const title = "Changelog — LLM Left";
const description = "LLM Left release notes: multiple Codex and Claude accounts, a per-Mac iCloud publishing switch, Grok and OpenRouter, alerts, and banked Codex resets.";
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  url: `${site.url}/changelog/`,
  description,
  isPartOf: { "@type": "WebSite", name: site.name, url: site.url },
};
---

<Layout title={title} description={description} path="/changelog/" schema={schema}>
  <PageShell eyebrow="Changelog" title="What changed." intro="Public release notes for the signed LLM Left Mac app. The update feed remains the source of truth for the current version.">
    {releases.map((entry, index) => (
      <article class="release-entry">
        <div class="release-entry-meta">
          <span class="version-pill">{entry.version}</span>
          <time datetime={entry.published}>{formatReleaseDate(entry.published)}</time>
        </div>
        <div class="release-entry-copy">
          <h2>{entry.headline}</h2>
          <ul>
            {entry.notes.map((note) => <li>{note}</li>)}
          </ul>
          {index === 0 && (
            <a class="button button-dark" href={release.downloadUrl}>Download {release.version} <span aria-hidden="true">↓</span></a>
          )}
        </div>
      </article>
    ))}
  </PageShell>
</Layout>
