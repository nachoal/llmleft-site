---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found — LLM Left" description="The requested LLM Left page could not be found. Return to the product homepage or open the current Mac download page." path="/404/" noindex>
  <main class="not-found page-container">
    <p class="eyebrow">404</p>
    <h1>This limit does not exist.</h1>
    <p>The page moved, or the address is not valid.</p>
    <div class="hero-actions">
      <a class="button button-green" href="/">Go home</a>
      <a class="button button-light" href="/download/">Download</a>
    </div>
  </main>
</Layout>

