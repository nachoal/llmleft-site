{/* Replica of DashboardView (App/DashboardView.swift), dark appearance.
   Sized in em so wrappers scale it via font-size. */}
<div class="ios-phone" aria-label="LLM Left iPhone app showing the remaining Claude limit and daily pace">
  <div class="ip-screen">
    <div class="ip-island" aria-hidden="true"></div>
    <div class="ip-status" aria-hidden="true"><span>9:41</span><span>● ● ▰</span></div>
    <div class="ip-navbar" aria-hidden="true">
      <svg class="mp-glyph" viewBox="0 0 16 16"><circle cx="8" cy="8" r="2.1" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 1.7v2M8 12.3v2M1.7 8h2M12.3 8h2M3.55 3.55l1.4 1.4M11.05 11.05l1.4 1.4M12.45 3.55l-1.4 1.4M4.95 11.05l-1.4 1.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      <svg class="mp-glyph" viewBox="0 0 16 16"><path d="M13.2 8a5.2 5.2 0 1 1-1.6-3.75" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M11.2 1.6l.6 2.8-2.8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="ip-title">LLM Left</div>

    <div class="ip-card ip-quota">
      <div class="ip-quota-head">
        <div class="ip-quota-name">
          <strong>Claude</strong>
          <span>All Models</span>
        </div>
        <b class="sys-badge sys-badge-orange">7D</b>
      </div>
      <div class="ip-hero"><b>82</b><i>%</i></div>
      <span class="ip-hero-sub">left</span>
      <div class="sys-meter ip-meter"><span class="sys-meter-orange pct-82"></span></div>
      <span class="ip-resets">Resets in 1 day, 12 hr</span>
    </div>

    <div class="ip-card ip-pace">
      <div class="ip-pace-head">
        <div class="ip-quota-name">
          <strong>Daily pace</strong>
          <span>Based on the All Models limit</span>
        </div>
        <b class="ip-ontrack">✓ On track</b>
      </div>
      <div class="ip-pace-metrics">
        <div><span>Recent average</span><b>8.1% / day</b></div>
        <div><span>Daily target</span><b>11.7% / day</b></div>
      </div>
      <div class="ip-pace-projected">
        <span>Projected left at reset</span>
        <b>42%</b>
      </div>
    </div>
  </div>
</div>
