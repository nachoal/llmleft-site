{/* Replica of CombinedUsageWidgetView (Widget/LLMLeftWidget.swift), systemMedium, dark.
   Sized in em so wrappers scale it via font-size. */}
<div class="w-medium" aria-label="Codex plus Claude usage widget">
  <div class="w-col">
    <div class="w-col-head"><strong>Codex</strong><b class="sys-badge sys-badge-blue">7D</b></div>
    <div class="w-hero"><b>68</b><i>%</i></div>
    <span class="w-sub">left</span>
    <div class="sys-meter"><span class="sys-meter-blue" style="width:68%"></span></div>
    <span class="w-resets">Resets in 5 days</span>
  </div>
  <div class="w-divider" aria-hidden="true"></div>
  <div class="w-col">
    <div class="w-col-head"><strong>Claude</strong><b class="sys-badge sys-badge-orange">7D</b></div>
    <div class="w-hero"><b>82</b><i>%</i></div>
    <span class="w-sub">left</span>
    <div class="sys-meter"><span class="sys-meter-orange" style="width:82%"></span></div>
    <span class="w-resets">Resets in 1 day</span>
  </div>
</div>
